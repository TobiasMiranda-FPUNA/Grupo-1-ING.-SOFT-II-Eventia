DATABASE_URL=postgresql+psycopg://eventia:eventia@localhost:5432/eventia
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
FRONTEND_BASE_URL=http://localhost:4200

# Envío de certificados por correo (opcional). Sin SMTP_HOST los
# certificados se emiten igual pero no se envían.
# Ejemplo con Gmail: usar una "contraseña de aplicación" (no la del correo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
